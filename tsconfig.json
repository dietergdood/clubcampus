{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Node-Typen für Tests, die den Quelltext lesen (z.B. icons.test.ts).
       Betrifft nur die Typprüfung — im Bundle landet nichts davon. */
    "types": ["node", "vite/client"],

    /* JavaScript Interop */
    "allowJs": true,
    "checkJs": false,

    /* Strictness — schrittweise aktivieren */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Paths — TS 7: kein baseUrl mehr, Pfade relativ zur tsconfig */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
